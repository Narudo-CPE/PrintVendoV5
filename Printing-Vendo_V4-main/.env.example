# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LAN address of the confirmation/cashier app, including its port.
# Example: http://192.168.1.25:3001
OWNER_APP_URL="http://192.168.1.25:3001"

# Self-Service Print Kiosk Configuration
# Optional API URL for the Capacitor Admin app. Set the Pi's reachable LAN URL
# when building the APK. Web kiosk pages derive the Pi hostname from their URL
# and use the Python backend's default port (3000) when this is unset.
VITE_API_URL="http://192.168.1.25:3000"
VITE_API_PORT="3000"
# System queue backed by Gutenprint for the connected Epson L120.
CUPS_PRINTER_NAME="L120-Series"
# Physical Gutenprint printing is the default. Set to "simulation" only for testing.
PRINT_MODE="gutenprint"

# PayMongo GCash API (test mode default: sk_test_ / pk_test_)
PAYMONGO_MODE="test"
PAYMONGO_SECRET_KEY="sk_test_demo1234567890abcdef"
PAYMONGO_PUBLIC_KEY="pk_test_demo1234567890abcdef"

# Telegram Bot Audit Notifications (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Dual Arduino serial ports (leave blank for OS defaults)
SERIAL_PORT=""
ACCEPTOR_SERIAL_PORT=""
ACTUATOR_SERIAL_PORT=""
SERIAL_BAUDRATE="115200"

# Isolated manual GCash confirmation app (use unique values in the real .env)
GCASH_CONFIRM_PASSWORD=""
GCASH_CONFIRM_TOKEN=""
GCASH_CONFIRM_HOST="127.0.0.1"
GCASH_CONFIRM_PORT="8080"
GCASH_CONFIRM_NOTIFY_URL="http://127.0.0.1:8080/internal/payment-request"
GCASH_CONFIRM_STATUS_URL="http://127.0.0.1:8080/internal/system-status"
KIOSK_BACKEND_URL="http://127.0.0.1:3000"
SYSTEM_STATUS_INTERVAL_SECONDS="4"

# Pricing & Paper Constants
BASE_PRICE_BW="2.00"
BASE_PRICE_COLOR="5.00"
PIXEL_RATE_BW="0.000008"
PIXEL_RATE_COLOR="0.000025"
GRAYSCALE_RATE="0.000008"
COLOR_RATE="0.000025"
MAX_PAYABLE_AMOUNT="200.0"
HOTSPOT_FILE_TTL_MINUTES="30"
# Uploaded documents are stored locally on the Raspberry Pi and removed after the TTL.
UPLOAD_DIR="./uploads"
BLUETOOTH_RECEIVE_DIR="./bluetooth_received"

